/target
tools/*/target
# Standalone `cargo test` runs inside the vendored crate (see
# vendor/embedded-sdmmc/VENDOR.md) produce their own target/ + lockfile.
vendor/*/target
vendor/*/Cargo.lock
Cargo.lock.bak
*.img
scripts/classify-out/*
scripts/disasm-out/*
tarmac.log
tarmac-window.log
docs/ARM_*
# Generated by scripts/dump-data-regions.py — large (~20 MiB each),
# regen-able. Live alongside the bitmaps under classify/<hash>/.
/classify/*/data-regions.txt
/classify/*/code-regions.txt

# Top-level Einstein .gitignore excludes ".claude" recursively so each
# developer's personal Claude Code config (~/.claude or per-project
# settings.local.json) stays untracked. The team-shared
# .claude/settings.json (a project hook config — see iter-92) is the
# exception: re-include just the directory entry and that one file.
!.claude/
.claude/*
!.claude/settings.json

# Newton ROMs are not redistributable. Each developer places their own dump
# under roms/; the directory itself is tracked (for the README) but all
# contents are ignored.
/roms/*
!/roms/README.md
*.rom
*.rex
nhboot/target
