#!/usr/bin/env bash
# Run an AArch64 bare-metal ELF under FVP_Base_RevC-2xAEMvA.
#
# Hides the Docker invocation and the FVP -C parameters that took an
# evening to converge on (see reference_fvp_base_revc.md). The FVP runs
# inside the armswdev/aemfvp-cca-v2-image container via OrbStack — native
# arm64 on Apple Silicon.
#
# Usage:
#   scripts/fvp <elf>                Boot the ELF, stream UART to stdout,
#                                    exit when guest emits EOT (0x04).
#   scripts/fvp --gdb <elf>          Same but pause at entry with an Iris
#                                    debug server on host port 7100.
#   scripts/fvp --timeout=N <elf>    Kill the sim after N seconds.
#
# Env:
#   FVP_IMAGE   Override the Docker image (default armswdev/aemfvp-cca-v2-image:latest)
#   FVP_EXTRA   Extra '-C ...' arguments forwarded to the FVP.

set -euo pipefail

IMAGE="${FVP_IMAGE:-armswdev/aemfvp-cca-v2-image:latest}"
FVP_BIN=/tmp/cca-stack/Base_RevC_AEMvA_pkg/models/Linux64_armv8l_GCC-9.3/FVP_Base_RevC-2xAEMvA

gdb=0
tarmac=""
# --tarmac-window enables the plugin but starts with tracing DISABLED.
# The hypervisor's src/tarmac.rs emits `<<TRM_START>>` / `<<TRM_STOP>>`
# on UART; bp.pl011_uart0.toggle_mti toggles TarmacTrace on/off when
# those tokens appear. Useful for capturing a focused slice around a
# Phase B stall rather than a 10+ GiB full-boot trace.
tarmac_window=""
# FVP runs the generic timer and cache model accurately, so long-running
# memory operations (e.g. the hypervisor zeroing ~28 MiB of BSS) can
# take tens of seconds of wall time — much longer than the equivalent
# QEMU TCG run. Default timeout is generous enough for a cold boot into
# a guest test.
timeout_secs=300
elf=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --gdb)                  gdb=1; shift ;;
        --tarmac)               tarmac="/work/baremetal/tarmac.log"; shift ;;
        --tarmac=*)             tarmac="${1#--tarmac=}"; shift ;;
        --tarmac-window)        tarmac_window="/work/baremetal/tarmac-window.log"; shift ;;
        --tarmac-window=*)      tarmac_window="${1#--tarmac-window=}"; shift ;;
        --timeout=*)            timeout_secs="${1#--timeout=}"; shift ;;
        --image=*)              IMAGE="${1#--image=}"; shift ;;
        -h|--help)
            sed -n '3,/^set -e/p' "$0" | sed -n '1,/^set -e/p' | head -n -1 | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        --) shift; break ;;
        -*) echo "unknown flag: $1" >&2; exit 2 ;;
        *)  elf="$1"; shift ;;
    esac
done

if [[ -n "$tarmac" && -n "$tarmac_window" ]]; then
    echo "$0: --tarmac and --tarmac-window are mutually exclusive" >&2
    exit 2
fi

if [[ -z "$elf" ]]; then
    echo "usage: $0 [--gdb] [--timeout=N] <elf>" >&2
    exit 2
fi
if [[ ! -f "$elf" ]]; then
    echo "$0: $elf not found" >&2
    exit 2
fi

# Resolve to absolute host path so the Docker bind-mount always finds it.
elf_abs="$(cd "$(dirname "$elf")" && pwd)/$(basename "$elf")"

# Mount the project root so relative paths in the ELF (e.g. snapshot
# files opened via semihosting) resolve against the host as expected.
here="$(cd "$(dirname "$0")" && pwd)"
mount_root="$(cd "$here/../.." && pwd)"
rel_elf="${elf_abs#$mount_root/}"

# FVP parameters. See reference_fvp_base_revc.md for why each matters.
#
# has_el3=1: we enter at EL3, run a tiny stub in boot.s that wakes the
# GICv3 redistributor (GICR_WAKER is Secure-only), sets GICD_CTLR.DS=1,
# and ERETs to EL2. Without EL3 the hypervisor cannot wake the RD at
# all — GICR_WAKER writes from NS are ignored and the CPU interface
# never sees any PPI deliveries.
fvp_args=(
    -a "cluster0.cpu0=/work/$rel_elf"
    -C cluster0.has_el3=1
    -C cluster0.NUM_CORES=1
    -C cluster1.NUM_CORES=1
    -C cluster0.cpu0.RVBAR=0x80000000
    -C bp.secure_memory=0
    -C bp.pl011_uart0.uart_enable=1
    -C bp.pl011_uart0.out_file=-
    -C bp.pl011_uart0.unbuffered_output=1
    -C bp.pl011_uart0.shutdown_on_eot=1
    -C bp.terminal_0.start_telnet=0
    -C bp.terminal_0.mode=raw
    -C bp.terminal_1.start_telnet=0
    -C bp.terminal_2.start_telnet=0
    -C bp.terminal_3.start_telnet=0
)

# Give the container a unique name so we can forcibly stop it on exit.
# `--rm` alone is not enough: if this script is killed (e.g. `timeout`
# firing the outer deadline, or a grep|head upstream closing the pipe)
# the docker CLI exits without signalling the container, which then
# keeps running the FVP binary at 100% CPU until reboot. `--init`
# runs tini as PID 1 inside the container so SIGTERM reaches the FVP
# process cleanly when we do stop it.
cname="newton-fvp-$$-$RANDOM"
cleanup() {
    docker rm -f "$cname" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM HUP

docker_args=(
    run --rm --init --name "$cname" --platform linux/arm64
    -v "$mount_root:/work"
    -w /work
)

if [[ "$gdb" == "1" ]]; then
    fvp_args+=(-I --iris-port 7100 -p)
    docker_args+=(-p 7100:7100)
    echo "[fvp] Iris debug server will listen on host :7100 (paused at entry)." >&2
fi

# TarmacTrace plugin — instruction-level trace of every retired guest
# instruction. Output goes to the host path we give as --tarmac=
# (resolved relative to the host; written inside the container under
# /work). Volume is reduced by disabling load/store / cache / MMU-walk
# / VFP / GIC records — we're after the INSN + mode-change + CP15
# stream, which is enough to pinpoint boot-time stalls.
if [[ -n "$tarmac" ]]; then
    plugin="/tmp/cca-stack/Base_RevC_AEMvA_pkg/plugins/Linux64_armv8l_GCC-9.3/TarmacTrace.so"
    if [[ "$tarmac" = "$mount_root"/* ]]; then
        rel_tarmac="/work/${tarmac#$mount_root/}"
    else
        rel_tarmac="$tarmac"
    fi
    fvp_args+=(
        --plugin "$plugin"
        -C "TRACE.TarmacTrace.trace-file=$rel_tarmac"
        -C "TRACE.TarmacTrace.trace_loads_stores=0"
        -C "TRACE.TarmacTrace.trace_cache=0"
        -C "TRACE.TarmacTrace.trace_mmu=0"
        -C "TRACE.TarmacTrace.trace_vfp=0"
        -C "TRACE.TarmacTrace.trace_gicv3=0"
        -C "TRACE.TarmacTrace.trace_dap=0"
    )
    echo "[fvp] TarmacTrace -> $tarmac (filtered: insn+events+cp15)" >&2
fi

# TarmacTrace with UART-token-gated windowing. Plugin is loaded but
# tracing is OFF until the hypervisor emits `<<TRM_START>>` on UART0,
# and resumes OFF again on `<<TRM_STOP>>`. Paired with src/tarmac.rs
# which emits those markers around the stall site currently being
# investigated.
if [[ -n "$tarmac_window" ]]; then
    plugin="/tmp/cca-stack/Base_RevC_AEMvA_pkg/plugins/Linux64_armv8l_GCC-9.3/TarmacTrace.so"
    if [[ "$tarmac_window" = "$mount_root"/* ]]; then
        rel_tarmac="/work/${tarmac_window#$mount_root/}"
    else
        rel_tarmac="$tarmac_window"
    fi
    # JSON for toggle_mti: tracing is OFF at boot because start_substr
    # is supplied (see `-C bp.pl011_uart0.toggle_mti=help`).
    toggle_json='{"start_substr":"<<TRM_START>>","stop_substr":"<<TRM_STOP>>","units":["TarmacTrace"],"required":"true"}'
    # LS tracing is ON for the windowed variant — the typical use case
    # is "something corrupted memory at address X, find the writer."
    # Filtering load/stores makes that impossible; keep the window tight
    # via toggle_mti instead.
    fvp_args+=(
        --plugin "$plugin"
        -C "TRACE.TarmacTrace.trace-file=$rel_tarmac"
        -C "TRACE.TarmacTrace.trace_loads_stores=1"
        -C "TRACE.TarmacTrace.trace_cache=0"
        -C "TRACE.TarmacTrace.trace_mmu=0"
        -C "TRACE.TarmacTrace.trace_vfp=0"
        -C "TRACE.TarmacTrace.trace_gicv3=0"
        -C "TRACE.TarmacTrace.trace_dap=0"
        -C "bp.pl011_uart0.toggle_mti=$toggle_json"
    )
    echo "[fvp] TarmacTrace (windowed, with loads/stores) -> $tarmac_window" >&2
    echo "[fvp]   start=<<TRM_START>>  stop=<<TRM_STOP>>" >&2
fi

# Forward any FVP_EXTRA argument string as additional -C params.
if [[ -n "${FVP_EXTRA:-}" ]]; then
    # shellcheck disable=SC2206
    extra=($FVP_EXTRA)
    fvp_args+=("${extra[@]}")
fi

set -o pipefail

# `timeout -k 5` escalates to SIGKILL 5 s after the initial SIGTERM
# if docker is still alive; combined with the EXIT trap above this
# guarantees no orphaned container survives the script's death.
# NB: not using `exec` — exec replaces the shell and the trap would
# never fire.
rc=0
timeout -k 5 "$timeout_secs" docker "${docker_args[@]}" \
    --entrypoint "$FVP_BIN" "$IMAGE" "${fvp_args[@]}" || rc=$?

# Post-run: if a tarmac file was produced and exceeds the size cap,
# truncate it in place so a run-away trace can't silently fill the
# host disk across repeated runs. Override the cap with
# FVP_TARMAC_MAX (bytes); default 1 GiB.
tarmac_max="${FVP_TARMAC_MAX:-1073741824}"
for path in "$tarmac" "$tarmac_window"; do
    if [[ -n "$path" && -f "$path" ]]; then
        size=$(stat -f%z "$path" 2>/dev/null || stat -c%s "$path" 2>/dev/null || echo 0)
        if [[ "$size" -gt "$tarmac_max" ]]; then
            head -c "$tarmac_max" "$path" > "$path.trunc" && mv "$path.trunc" "$path"
            echo "[fvp] tarmac log truncated to ${tarmac_max} bytes (was ${size})." >&2
        fi
    fi
done

exit "$rc"
