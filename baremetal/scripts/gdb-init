# gdb init for the Newton hypervisor.
#
# Usage:
#   terminal 1: DEBUG=1 cargo run --release
#   terminal 2: aarch64-elf-gdb -q -x scripts/gdb-init \
#                 target/aarch64-unknown-none-softfloat/release/newton-hypervisor
#
# What works:
#   - Source-level breakpoints in EL2 AArch64 hypervisor code (kmain,
#     trap_sync_lower_aarch32, handle_data_abort, …). `break <fn>`,
#     `stepi`, `bt`, `info locals` all work.
#
# What does NOT work (QEMU limitation, not ours):
#   - Breakpoints or register inspection directly in the AArch32 EL1
#     guest. qemu-system-aarch64's gdbstub is aarch64-only and does not
#     handle the mode switch; software bkpts are ignored and `info
#     registers` shows garbage once the guest is running.
#     Ref: https://lists.gnu.org/archive/html/qemu-arm/2020-07/msg00122.html
#
# Workarounds for "break when guest reaches PC=X":
#   - `bg <addr>`:  break in the EL2 sync-trap handler whenever the
#      trapped guest PC (ELR_EL2) matches. Zero-setup, but only fires
#      at trap-inducing guest instructions (data/insn abort, SVC/HVC,
#      CP15, UND).
#   - `bp <addr>`:  patch the guest ROM word at <addr> with a marker
#      UDF via the hypervisor's `install_guest_bp` entry point, and
#      arm `bg <addr>` in one shot. When the guest executes that PC,
#      it UND-traps into EL2, gdb stops at trap_sync_lower_aarch32
#      with $ELR_EL2 == <addr>, and the hypervisor restores the
#      original instruction before ERET. One-shot — re-install to
#      re-arm. ROM range only (0..0x01000000). See src/guest_bp.rs.

set pagination off
set confirm off
set print asm-demangle on
set print pretty on
# Force sync continue; gdb 17 defaults some remote paths to async.
set non-stop off
set mi-async off

target remote :1234

# Pretty-print the current guest-visible state on any stop at an EL2
# sync trap. ELR_EL2 = guest PC, ESR_EL2 = exception syndrome, FAR_EL2 =
# faulting addr for aborts. Ignore errors if we're not in a trap frame.
define guest-state
  printf "guest PC (ELR_EL2) = 0x%x\n", $ELR_EL2
  printf "ESR_EL2            = 0x%x\n", $ESR_EL2
  printf "FAR_EL2            = 0x%x\n", $FAR_EL2
  printf "SPSR_EL2 (guest CPSR) = 0x%x\n", $SPSR_EL2
end
document guest-state
Dump the guest-visible context at a sync trap from a lower EL:
ELR_EL2 is the guest PC, ESR_EL2 the syndrome, FAR_EL2 the faulting VA.
end

# `bg ADDR` — stop the next time the guest takes a sync trap while its
# PC is ADDR. Only fires at trap-inducing guest instructions.
define bg
  break trap_sync_lower_aarch32 if $ELR_EL2 == $arg0
  printf "Will stop when guest sync-traps with PC == 0x%x.\n", $arg0
  printf "Note: only fires if the guest instruction at that PC causes\n"
  printf "a data/insn abort, SVC/HVC, CP15, or UND exception.\n"
end
document bg
bg ADDR -- break when the guest takes a sync trap with ELR_EL2 == ADDR.
end

# `bp ADDR` — install a one-shot guest software breakpoint at a ROM
# address and arm the gdb-side conditional stop. Works for any PC in
# the 16 MiB ROM window, not just natural trap points. Invokes
# `install_guest_bp` in the hypervisor via gdb's `call`.
define bp
  # Call the extern "C" entry point in src/guest_bp.rs. The Rust-
  # mangled version and the unmangled #[no_mangle] symbol both exist;
  # we qualify by module path so gdb picks the Rust signature with
  # DWARF types.
  set $_rc = newton_hypervisor::guest_bp::install_guest_bp($arg0)
  if $_rc < 0
    printf "install_guest_bp(0x%x) failed: rc=%d (see src/guest_bp.rs for codes)\n", $arg0, $_rc
  else
    printf "guest_bp installed at 0x%x (slot %d); arming stop...\n", $arg0, $_rc
    # Stable stop point: `bp_hit_anchor`, an empty `#[inline(never)]`
    # `extern "C"` function called from `handle_user_bp_und` right
    # after the slot lookup confirms a real BP hit, before any
    # special-case PC dispatch. See src/guest_bp.rs.
    #
    # Why a function and not a line-numbered breakpoint:
    #   - line numbers drift as the source moves (we've already had
    #     `:481` resolve to `:495` because gdb walked forward looking
    #     for an executable instruction in a kprintln macro);
    #   - at the function entry, `faulting_pc` is the first AAPCS64
    #     arg (in `w0`), so the conditional filter is reliable, unlike
    #     mid-function points where the value can be optimized out;
    #   - the symbol exists for both probe and user BPs, so unlike the
    #     prior anchor in the default tail, this fires for any BP —
    #     including the always-armed probes (0x310e24, 0x1a4948,
    #     0x142df0, 0x313308) when the user explicitly bp's them.
    # `tbreak` (one-shot) matches the underlying guest_bp's one-shot
    # semantic — fires once and auto-deletes, so repeated `bp`
    # invocations don't accumulate stale gdb breakpoints.
    # Filter on $x0 (the AAPCS64 register that holds the first arg at
    # function entry) rather than the Rust parameter name. The named
    # symbol can show as "optimized out" in DWARF at the immediate
    # entry of an `#[inline(never)]` shim that just forwards to
    # black_box, but $x0 is always live there. Bitwise-mask the low 32
    # bits because:
    #   - faulting_pc is `u32`; AAPCS64 passes it in the low half of
    #     x0 (= w0) and leaves the high half unspecified;
    #   - gdb's Rust language hook rejects C-style casts like
    #     `(unsigned)$x0`, but `&` works in every language.
    # Parentheses required because `==` binds tighter than `&` in gdb.
    tbreak bp_hit_anchor if ($x0 & 0xffffffff) == $arg0
  end
end
document bp
bp ADDR -- install a one-shot guest software BP at ADDR (ROM range),
and arm a gdb-side conditional stop so `continue` lands on it. The
hypervisor restores the original instruction in the UND handler, so
the BP fires exactly once; `bp ADDR` again to re-arm.
end

# `bp-clear ADDR` — remove a previously installed BP.
define bp-clear
  set $_rc = newton_hypervisor::guest_bp::remove_guest_bp($arg0)
  if $_rc < 0
    printf "remove_guest_bp(0x%x) failed: rc=%d\n", $arg0, $_rc
  else
    printf "guest_bp removed at 0x%x\n", $arg0
  end
end
document bp-clear
bp-clear ADDR -- remove a BP installed via `bp ADDR`. Does not touch
the gdb-side conditional bg breakpoints; `delete <n>` them separately.
end

# `bp-list` — dump the active breakpoint table to the hypervisor console.
define bp-list
  call newton_hypervisor::guest_bp::list_guest_bps()
end
document bp-list
bp-list -- print the hypervisor's live guest-bp table on the kprintln!
console (serial).
end

# `tt N` — print the first N sync traps' guest PC + ESR as they happen,
# then stop on the Nth. gdb convenience var $_trap_count accumulates
# across multiple tt invocations; reset it manually if you want fresh
# counting. Useful for fast cadence inspection.
define tt
  set $_trap_count = 0
  set $_trap_limit = $arg0
  break trap_sync_lower_aarch32
  commands
    silent
    set $_trap_count = $_trap_count + 1
    printf "#%d trap @ guest PC = 0x%x  ESR = 0x%x\n", $_trap_count, $ELR_EL2, $ESR_EL2
    if $_trap_count < $_trap_limit
      continue
    end
  end
  printf "Will log up to %d traps and stop on the last one.\n", $arg0
end
document tt
tt N -- log the first N sync traps' guest PC + ESR, then stop.
end

# `ctt` — current task trace. Calls into the hypervisor to print the
# currently-running task's call chain from live banked registers.
# ELR_EL2 is read inside the hypervisor so the value is fresh; SP/LR/FP
# come from the trap context (passed in via `ctx`) per Table D1-79.
#
# Requires `ctx` to be visible in the current frame. If you're stopped
# at `bp_hit_anchor`, that fn doesn't take ctx — `up` until you reach
# `handle_user_bp_und` (or any trap-handler frame that took a
# `&mut TrapContext`), then run `ctt`.
#
# `dump_current_chain` is `#[no_mangle] extern "C"` and present in the
# symbol table, but gdb's Rust language hook refuses to look it up
# from Rust source contexts ("No symbol in current context") because
# the function isn't declared in Rust scope at the stop frame.
# Switching the language to C for the duration of the call lets gdb
# resolve the unmangled name and synthesise a `void(void*)` signature
# from the symbol table; we restore `auto` immediately after so the
# rest of the session keeps Rust pretty-printing.
define ctt
  set language c
  if $argc == 0
    call dump_current_chain(ctx)
  else
    call dump_chain_at(ctx, $arg0)
  end
  set language auto
end
document ctt
ctt [PC] -- print the currently-running task's call chain (one fn
per line) to the hypervisor serial console (not gdb).

  ctt              uses ELR_EL2 as the leaf PC. Right for most
                   trap-handler stops (data abort, IRQ, …).
  ctt faulting_pc  uses an explicit PC. Use this at a guest-BP stop
                   (`up` to bp_hit_anchor first so `faulting_pc` is
                   in scope), where ELR_EL2 points at the UND
                   trampoline rather than the BP'd guest PC.
                   `ctt $x0` works equivalently at the bp_hit_anchor
                   entry, since faulting_pc is the first AAPCS64 arg.

Requires `ctx` to be visible in the current frame. From a stop
inside `core::hint::black_box` (frame 0), `up` once to reach
`bp_hit_anchor` (frame 1) — `ctx` is now passed there as the second
arg, so it stays in DWARF.
end

printf "gdb connected. Handy commands:\n"
printf "  break kmain              # EL2 hypervisor entry\n"
printf "  break trap_sync_lower_aarch32\n"
printf "  guest-state              # dump guest PC/ESR/FAR/CPSR at an EL2 sync-trap stop\n"
printf "  ctt                      # print current task's call chain (needs `ctx` in scope)\n"
printf "  bg  0x<addr>             # break when guest *sync-traps* at that PC\n"
printf "  bp  0x<addr>             # install guest sw BP at ROM addr + arm bg (one-shot)\n"
printf "  bp-clear 0x<addr>        # remove a bp-installed BP\n"
printf "  bp-list                  # dump hypervisor's bp table (to serial console)\n"
printf "  tt  20                   # log 20 sync traps and stop\n"
